{
  "name": "@rock/rock-llm-relay",
  "description": "Rock ConnectorClient LLM relay: OpenAI-compatible loopback endpoint that forwards external-tool LLM calls to the Seagull cloud LLM Proxy with provenance injection (D-034)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@rock/rock-log-store": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
